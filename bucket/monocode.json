{
    "version": "0.9.0",
    "description": "Desktop UI for your coding agents (Claude Code, Codex, Cursor, OpenCode and more)",
    "homepage": "https://github.com/hardbeat920/monocode",
    "license": "MIT",
    "notes": [
        "MonoCode drives coding agent CLIs that are already installed and logged in (Claude Code, Codex, Cursor, OpenCode, Pi, omp, fx, Hermes Agent).",
        "The upstream Windows release only ships an NSIS installer, so this manifest unpacks it; the installer's WebView2 bootstrap is skipped (Windows 11 already includes the WebView2 Runtime)."
    ],
    "architecture": {
        "64bit": {
            "url": "https://github.com/hardbeat920/monocode/releases/download/v0.9.0/MonoCode_0.9.0_x64-setup.exe",
            "hash": "6166f84d125d726ccb32f917ee1d99cd4b1b2e671fb899c05d3dd83b0cac2c32"
        }
    },
    "installer": {
        "script": "7z x \"$dir\\$fname\" -o\"$dir\" -y | Out-Null"
    },
    "post_install": "Remove-Item \"$dir\\$fname\", \"$dir\\`$PLUGINSDIR\", \"$dir\\Uninstall*\" -Recurse -Force -ErrorAction SilentlyContinue",
    "bin": "monocode.exe",
    "shortcuts": [
        [
            "monocode.exe",
            "MonoCode"
        ]
    ],
    "checkver": {
        "github": "https://github.com/hardbeat920/monocode"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/hardbeat920/monocode/releases/download/v$version/MonoCode_$version_x64-setup.exe",
                "hash": {
                    "mode": "download"
                }
            }
        }
    }
}
